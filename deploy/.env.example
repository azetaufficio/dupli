# Public host name agents use (DNS must point here for automatic TLS). "localhost" for local tests.
DUPLI_HOST=backup.example.com

POSTGRES_PASSWORD=change-me

# M2 admin API key (header X-Dupli-Admin-Key). Replaced by Entra ID login in M3.
DUPLI_ADMIN_API_KEY=change-me-long-random

# Alert e-mails. For local dev with `--profile dev`: SMTP_HOST=mailpit, SMTP_PORT=1025, SMTP_SECURITY=None
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=StartTls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=dupli@example.com
SMTP_TO=ops@example.com
