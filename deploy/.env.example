# Public host name agents use (DNS must point here for automatic TLS). "localhost" for local tests.
DUPLI_HOST=backup.example.com

POSTGRES_PASSWORD=change-me

# Web UI login with Microsoft Entra ID. App registration: platform "Web", redirect URI
# https://<DUPLI_HOST>/signin-oidc, front-channel logout URL https://<DUPLI_HOST>/signout-callback-oidc,
# a client secret. Optionally define an app role (e.g. Dupli.Operator), assign it and set ENTRA_REQUIRED_ROLE;
# otherwise restrict access with "Assignment required" on the enterprise application.
DUPLI_AUTH_MODE=EntraId
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REQUIRED_ROLE=

# Optional admin API key for automation (header X-Dupli-Admin-Key). Leave empty to disable.
DUPLI_ADMIN_API_KEY=

# Alert e-mail channel: Smtp or Office365.
NOTIFICATIONS_CHANNEL=Smtp

# SMTP channel. For local dev with `--profile dev`: SMTP_HOST=mailpit, SMTP_PORT=1025, SMTP_SECURITY=None
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=StartTls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=dupli@example.com
SMTP_TO=ops@example.com

# Office365 channel (Microsoft Graph, app-only). The identity needs the Mail.Send application
# permission (admin consent); restrict it to O365_FROM with an application access policy.
# O365_CREDENTIAL: ClientSecret | Certificate (app registration: tenant + client id + secret/cert)
#   | ManagedIdentity (Azure-hosted only: O365_CLIENT_ID = user-assigned identity client id, empty = system-assigned;
#     grant Mail.Send with New-MgServicePrincipalAppRoleAssignment, the portal cannot).
# Certificate: PFX (+ password) or PEM with certificate and key, at a path inside the container (mount it).
O365_CREDENTIAL=ClientSecret
O365_TENANT_ID=
O365_CLIENT_ID=
O365_CLIENT_SECRET=
O365_CERTIFICATE_PATH=
O365_CERTIFICATE_PASSWORD=
O365_FROM=dupli@example.com
O365_TO=ops@example.com
O365_SAVE_TO_SENT_ITEMS=false
